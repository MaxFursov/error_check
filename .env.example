# Звідки брати експорт Проми
PROM_EXPORT_URL=https://www.dilovakovbasa.ua/upload/category/small/prom_export.xlsx

# Telegram: куди надсилати звіти (створіть бота через @BotFather, chat id — свій або групи)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude: перевірка орфографії та "логічних" помилок. Без ключа працюють лише правила.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Захист від витрат: жорсткий ліміт на місяць (USD). Бот зупиняється ДО перевищення
# і продовжує наступного місяця. Ціни нижче навмисно завищені (запас по ліміту).
AI_MONTHLY_BUDGET_USD=1.0
AI_PRICE_IN_PER_MTOK=3.0
AI_PRICE_OUT_PER_MTOK=15.0
# Максимум назв за один запуск
AI_MAX_NAMES_PER_RUN=3000

# Розклад (Europe/Kyiv): о котрій годині, і як часто (раз на N днів)
SCHEDULE_HOURS=8
SCHEDULE_MINUTE=0
CHECK_EVERY_DAYS=2

# Де зберігати стан (на Railway — шлях на Volume, наприклад /data/state.json)
STATE_PATH=state.json

# Чернетки описів (Опис_h2_uk) для товарів без опису. Вимкнено за замовчуванням.
DESC_ENABLED=false
DESC_SCHEDULE_HOURS=9
# Раз на скільки днів генерувати, і скільки описів за раз (стільки реально встигнути переглянути)
DESC_EVERY_DAYS=1
DESC_PER_RUN=30
DESC_MODEL=claude-sonnet-5-5
# Які товари: перше слово назви через кому («Сир» — лише сири; порожньо — усі)
DESC_ONLY_KINDS=Сир
# Іноземні (латинський бренд у назві, група не з українських) — першими
DESC_FOREIGN_FIRST=true
# true — шукати склад/калорійність в інтернеті (web_search), false — лише заголовок і короткий текст за назвою
DESC_RESEARCH=true
DESC_MAX_SEARCHES=3
# Через скільки днів нагадувати про чернетку, якщо в Промі опис так і не з'явився
DESC_REMIND_DAYS=14
# Черга за датою без збереженого стану (--window): розмір вікна на день і дата старту
DESC_WINDOW=30
DESC_START_DATE=2026-10-30
DESC_EFFORT=medium
# Окремий ліміт від перевірки помилок, USD на місяць. Один сир з пошуком ≈ кілька центів — див. рядок «Claude» у звіті
DESC_MONTHLY_BUDGET_USD=10.0
# Ціна одного пошуку для обліку бюджету (перевірте актуальну на сторінці цін Anthropic)
AI_PRICE_PER_SEARCH=0.01
# false — генерувати й для товарів, яких немає в наявності
DESC_ONLY_IN_STOCK=true
# За замовчуванням — descriptions.json поруч зі STATE_PATH (тобто на Volume)
DESC_STATE_PATH=
