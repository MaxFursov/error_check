# Звідки брати експорт Проми
PROM_EXPORT_URL=https://www.dilovakovbasa.ua/upload/category/small/prom_export.xlsx

# Telegram: куди надсилати звіти (створіть бота через @BotFather, chat id — свій або групи)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude: перевірка орфографії та "логічних" помилок. Без ключа працюють лише правила.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Ліміт назв, які відправляються в Claude за один запуск (захист від витрат)
AI_MAX_NAMES_PER_RUN=3000

# Розклад (Europe/Kyiv): о котрій годині, і як часто (раз на N днів)
SCHEDULE_HOURS=8
SCHEDULE_MINUTE=0
CHECK_EVERY_DAYS=2

# Де зберігати стан (на Railway — шлях на Volume, наприклад /data/state.json)
STATE_PATH=state.json
